# Auto detect text files and perform LF normalization
* text=auto

# Java sources
*.java text diff=java eol=lf
*.kt text eol=lf
*.kts text eol=lf

# Gradle
*.gradle text eol=lf
*.gradle.kts text eol=lf
gradlew text eol=lf
gradlew.bat text eol=crlf

# Properties
*.properties text eol=lf

# Config / Data
*.json text eol=lf
*.toml text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.xml text eol=lf

# Documentation
*.md text eol=lf
*.txt text eol=lf
LICENSE text eol=lf

# Shell scripts (LF only)
*.sh text eol=lf

# Batch scripts (CRLF only)
*.bat text eol=crlf
*.cmd text eol=crlf

# Minecraft / Mod binary files
*.jar binary
*.zip binary
*.gz binary
*.xz binary
*.litematic binary
*.schematic binary
*.schem binary
*.nbt binary

# Images
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.svg text eol=lf

# Compiled classes
*.class binary
*.dex binary

# Native libraries
*.so binary
*.dll binary
*.dylib binary

# Misc
*.log text eol=lf
