{
  "schemaVersion": 1,
  "id": "syncmaterial",
  "version": "${version}",
  "name": "SyncMaterial",
  "description": "An enhancement mod for Litematica and Syncmatica to provide material list statistics.",
  "authors": [
    "Kilo"
  ],
  "contact": {
    "homepage": "https://github.com/is-wuyi/Syncmaterial",
    "sources": "https://github.com/is-wuyi/Syncmaterial",
    "issues": "https://github.com/is-wuyi/Syncmaterial/issues"
  },
  "license": "GPL-3.0-only",
  "icon": "assets/syncmaterial/icon.png",
  "environment": "*",
  "entrypoints": {
    "main": [
      "net.syncmaterial.syncmaterial.SyncMaterial"
    ],
    "client": [
      "net.syncmaterial.syncmaterial.client.SyncMaterialClientBootstrap"
    ]
  },
  "mixins": [
    "syncmaterial.mixins.json"
  ],
  "depends": {
    "fabricloader": "${loader_dependency}",
    "minecraft": "${minecraft_dependency}",
    "java": ">=${java_version}",
    "fabric-api": "*"
  },
  "recommends": {
    "malilib": ">=${malilib_version}",
    "litematica": ">=${litematica_version}",
    "syncmatica": ">=${syncmatica_version}"
  }
}
