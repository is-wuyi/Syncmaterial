{
  "schemaVersion": 1,
  "id": "syncmaterial",
  "version": "${version}",
  "name": "SyncMaterial",
  "description": "An enhancement mod for Litematica and Syncmatica to provide material list statistics.",
  "authors": [
    "Kilo"
  ],
  "contact": {
    "homepage": "https://github.com/Kilo-Org/syncmaterial"
  },
  "license": "GPL-3.0-only",
  "icon": "assets/syncmaterial/icon.png",
  "environment": "*",
  "entrypoints": {
    "main": [
      "net.syncmaterial.syncmaterial.SyncMaterial"
    ],
    "client": [
      "net.syncmaterial.syncmaterial.client.SyncMaterialClient"
    ]
  },
  "mixins": [
    "syncmaterial.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=0.16.9",
    "minecraft": ">=1.21.7 <=1.21.8",
    "fabric-api": "*"
  },
  "recommends": {
    "litematica": ">=0.23.5",
    "syncmatica": ">=0.3.15"
  }
}
