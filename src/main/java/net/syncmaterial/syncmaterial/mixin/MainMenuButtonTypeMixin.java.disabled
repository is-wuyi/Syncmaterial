package net.syncmaterial.syncmaterial.mixin;

import ch.endte.syncmatica.litematica.gui.MainMenuButtonType;
import ch.endte.syncmatica.litematica.gui.ButtonListener;
import net.minecraft.client.MinecraftClient;
import net.syncmaterial.syncmaterial.client.SyncMaterialClient;
import net.syncmaterial.syncmaterial.network.RequestMaterialListC2SPacket;
import org.spongepowered.asm.mixin.Mixin;
import org.spongepowered.asm.mixin.injection.At;
import org.spongepowered.asm.mixin.injection.Inject;
import org.spongepowered.asm.mixin.injection.callback.CallbackInfoReturnable;

/**
 * Mixin to enable Main Menu button in Syncmatica.
 */
@Mixin(MainMenuButtonType.class)
public abstract class MainMenuButtonTypeMixin {

    @Inject(method = "isActive", at = @At("HEAD"), cancellable = true)
    private void forceActive(CallbackInfoReturnable<Boolean> cir) {
        if (MainMenuButtonType.this == MainMenuButtonType.MATERIAL_GATHERINGS) {
            cir.setReturnValue(true);
        }
    }

    @Inject(method = "getButtonListener", at = @At("HEAD"), cancellable = true)
    private void getListener(CallbackInfoReturnable<Object> cir) {
        if (MainMenuButtonType.this == MainMenuButtonType.MATERIAL_GATHERINGS) {
            // 创建新的 listener 触发 UI
            cir.setReturnValue((button, mouseButton) -> {
                MinecraftClient client = MinecraftClient.getInstance();
                if (client.player != null) {
                    // 发送请求到服务端
                    net.fabricmc.fabric.api.client.networking.v1.ClientPlayNetworking.send(new RequestMaterialListC2SPacket("syncmaterial_gui"));
                }
            });
        }
    }
}